# Copy this file to build.properties and adjust the paths for your machine.
# build.properties is read automatically by build.xml if it exists, and is
# meant to stay machine-specific (don't feel obliged to commit it as-is).

# Path to the jar of the JOSM install you're developing/testing against.
# Find it wherever your JOSM is installed/run from - it's usually called
# something like josm-tested.jar, josm-latest.jar, or just josm.jar.
josm.jar=/path/to/your/josm.jar

# Path to the JTS core dependency (see lib/README.txt for where to get it).
jts.jar=lib/jts-core-1.19.0.jar

# Java source/target level - match whatever your target JOSM version
# requires. 17 is a safe default for current JOSM; older JOSM releases
# accepted 11 or even 8.
java.source=17
java.target=17

# Only used by the optional "install" Ant target.
# Linux default shown; on Windows this is typically
# %APPDATA%\JOSM\plugins, on macOS ~/Library/JOSM/plugins.
josm.plugins.dir=${user.home}/.local/share/JOSM/plugins
